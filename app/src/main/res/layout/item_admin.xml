<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="16dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvAdminEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="אימייל: "
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvAdminItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="פיצות: "
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvAdminTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="סכום: ₪0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#C0392B"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvAdminStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="סטטוס: ממתין"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="8dp"/>

    <!-- כפתורי סטטוס -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnWaiting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ממתין"
            android:textSize="12sp"
            android:backgroundTint="#888888"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnPreparing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="בהכנה"
            android:textSize="12sp"
            android:backgroundTint="#E67E22"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnReady"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="מוכן"
            android:textSize="12sp"
            android:backgroundTint="#27AE60"/>

    </LinearLayout>

    <!-- כפתור דחייה -->
    <Button
        android:id="@+id/btnReject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❌ דחה הזמנה"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7F0000"
        android:layout_marginBottom="8dp"/>

    <!-- שורת טיימר -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="זמן בדקות"
            android:inputType="number"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSetTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הגדר זמן"
            android:backgroundTint="#C0392B"/>

    </LinearLayout>

</LinearLayout>